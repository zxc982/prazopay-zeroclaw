+// DeepSeek-compatible XML form:
+// `<tool_call name="tool_name">{"param":"value"}</tool_call>`.
+// Keep this deliberately narrow: the name must be a simple tool identifier and
+// the body must be one complete JSON object. Arbitrary JSON outside this
+// explicit envelope is never promoted to a tool call.
+fn parse_named_attribute_tool_calls(response: &str) -> Option<(String, Vec<ParsedToolCall>)> {
+    const OPEN: &str = "<tool_call name=\"";
+    const CLOSE: &str = "</tool_call>";
+
+    let mut text_parts = Vec::new();
+    let mut calls = Vec::new();
+    let mut remaining = response;
+
+    while let Some(start) = remaining.find(OPEN) {
+        let before = &remaining[..start];
+        if !before.trim().is_empty() {
+            text_parts.push(before.trim().to_string());
+        }
+
+        let after_marker = &remaining[start + OPEN.len()..];
+        let name_end = after_marker.find("\">")?;
+        let raw_name = &after_marker[..name_end];
+        if raw_name.is_empty()
+            || !raw_name
+                .chars()
+                .all(|ch| ch.is_ascii_alphanumeric() || matches!(ch, '_' | '-' | '.'))
+        {
+            return None;
+        }
+
+        let after_open = &after_marker[name_end + 2..];
+        let close_idx = after_open.find(CLOSE)?;
+        let arguments =
+            serde_json::from_str::<serde_json::Value>(after_open[..close_idx].trim()).ok()?;
+        if !arguments.is_object() {
+            return None;
+        }
+
+        calls.push(ParsedToolCall {
+            name: map_tool_name_alias(raw_name).to_string(),
+            arguments,
+            tool_call_id: None,
+        });
+        remaining = &after_open[close_idx + CLOSE.len()..];
+    }
+
+    if calls.is_empty() {
+        return None;
+    }
+    if !remaining.trim().is_empty() {
+        text_parts.push(remaining.trim().to_string());
+    }
+    Some((text_parts.join("\n"), calls))
+}
